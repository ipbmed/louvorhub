# Supabase (required for LouvorHub backend)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Assistente de IA (Edge Function assistant) — NÃO use prefixo VITE_.
# Configure como secrets do Supabase, não neste arquivo:
#   npx supabase secrets set OPENROUTER_API_KEY=sk-or-... OPENROUTER_MODEL=google/gemma-4-31b-it:free
#   npx supabase functions deploy assistant
# O modelo PRECISA suportar tool calling (lista: openrouter.ai/models?supported_parameters=tools).
# Conta free: use um slug com :free. Sem créditos, modelos pagos falham.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: Gemini (legacy AI Studio)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="http://localhost:3000"
